# Copy this file to .env and fill in real values. .env is gitignored.

OPENAI_API_KEY=sk-replace-me
GEMINI_API_KEY=               # only for gemini-* models
HUMAIN_API_KEY=               # only for humain-* models (HUMAIN Node preview access)
ANTHROPIC_API_KEY=            # only needed if any model below is claude-*

# Shared secret n8n sends as X-API-Key on every call to the API.
API_KEY=change-me-local-dev-key

# Vendor is inferred from the model name: claude-* -> Anthropic, else OpenAI.
CLASSIFY_MODEL=gpt-6-luna
CLASSIFY_FALLBACK_MODEL=claude-haiku-4-5
BRIEF_MODEL=gpt-6-sol
BRIEF_FALLBACK_MODEL=claude-sonnet-5-5

RISK_ALERT_THRESHOLD=0.7
ALERT_TARGET_MINUTES=15
DEDUP_SIMILARITY_THRESHOLD=0.90

# Base URL for the "read the full briefing" link sent to Slack (signed, expires after 72h).
PUBLIC_BASE_URL=http://localhost:8000
# DG-office copy of the link lives in channel history, so it lasts longer (hours).
DELIVERY_LINK_TTL_HOURS=720

# Public URL for n8n, set per machine for the demo (not shared): Slack's Approve
# button calls back to <this URL>/webhook-waiting-slack, so n8n must be reachable
# from the internet, e.g. a Cloudflare tunnel (cloudflared tunnel --url http://localhost:5678).
# Leave empty to run without the Slack Approve button (n8n then uses localhost).
N8N_WEBHOOK_URL=
