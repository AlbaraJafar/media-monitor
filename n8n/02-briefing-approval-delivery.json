    {
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM }}",
        "toEmail": "={{ $env.ANALYST_TEAM_EMAIL }}",
        "subject": "=Action needed: daily media briefing for {{ DateTime.fromISO($('Generate Draft').first().json.briefing_date).toFormat('cccc d LLLL yyyy') }} not yet approved",
        "emailFormat": "both",
        "text": "=The daily media briefing for {{ DateTime.fromISO($('Generate Draft').first().json.briefing_date).toFormat('cccc d LLLL yyyy') }} (briefing #{{ $('Generate Draft').first().json.briefing_id }}) has had no Approve or Disapprove for {{ ((m) => m >= 60 ? Math.floor(m / 60) + ' h ' + (m % 60) + ' min' : m + ' min')(Math.round(($now.toMillis() - new Date($('Generate Draft').first().json.created_at).getTime()) / 60000)) }}, so it has NOT been delivered to the DG office.\n\nVerification: {{ ({ passed: 'All claims verified against their sources', flagged: $('Generate Draft').first().json.unverified_claim_count + ' claim(s) could not be verified', not_run: 'Verification did not run', 'n/a': 'Degraded briefing (no AI summary)' })[$('Generate Draft').first().json.verification] }}\n\nHeadline summary:\n{{ $('Generate Draft').first().json.headline_text }}\n\nRead the full briefing: {{ $('Generate Draft').first().json.view_url }}\n\nTo decide: the buttons on the original Slack request have expired. Re-run workflow \"02 - Briefing Approval and Delivery\" in n8n to send a fresh approval request.",
        "options": {
          "appendAttribution": false
        },
        "html": "=<div style=\"margin:0;padding:24px 12px;background:#f3f4f7;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e2e5ec;border-radius:10px;border-collapse:separate;\">\n<tr><td style=\"background:#b45309;padding:14px 28px;border-radius:10px 10px 0 0;color:#ffffff;font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;\">Action needed &middot; Briefing not delivered</td></tr>\n<tr><td style=\"padding:28px 28px 8px 28px;\">\n<h1 style=\"margin:0 0 6px 0;font-size:21px;line-height:1.3;color:#1d2433;\">The daily media briefing has no decision yet</h1>\n<p style=\"margin:0;font-size:14px;color:#5b6475;\">{{ DateTime.fromISO($('Generate Draft').first().json.briefing_date).toFormat('cccc d LLLL yyyy') }} &middot; Briefing #{{ $('Generate Draft').first().json.briefing_id }}</p>\n</td></tr>\n<tr><td style=\"padding:16px 28px 4px 28px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:1px solid #eceef3;border-bottom:1px solid #eceef3;\">\n<tr><td style=\"padding:8px 0;color:#5b6475;font-size:13px;width:140px;vertical-align:top;\">Waiting for</td><td style=\"padding:8px 0;color:#1d2433;font-size:14px;font-weight:600;\">{{ ((m) => m >= 60 ? Math.floor(m / 60) + ' h ' + (m % 60) + ' min' : m + ' min')(Math.round(($now.toMillis() - new Date($('Generate Draft').first().json.created_at).getTime()) / 60000)) }}</td></tr>\n<tr><td style=\"padding:8px 0;color:#5b6475;font-size:13px;width:140px;vertical-align:top;\">Status</td><td style=\"padding:8px 0;color:#1d2433;font-size:14px;font-weight:600;\"><span style=\"color:#b45309;\">Not delivered to the DG office</span></td></tr>\n<tr><td style=\"padding:8px 0;color:#5b6475;font-size:13px;width:140px;vertical-align:top;\">Verification</td><td style=\"padding:8px 0;color:#1d2433;font-size:14px;font-weight:600;\">{{ ({ passed: 'All claims verified against their sources', flagged: $('Generate Draft').first().json.unverified_claim_count + ' claim(s) could not be verified', not_run: 'Verification did not run', 'n/a': 'Degraded briefing (no AI summary)' })[$('Generate Draft').first().json.verification] }}</td></tr>\n</table>\n</td></tr>\n<tr><td style=\"padding:20px 28px 4px 28px;\">\n<p style=\"margin:0 0 8px 0;font-size:12px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#5b6475;\">Headline summary</p>\n<div style=\"background:#f7f8fa;border-left:3px solid #c7ccd6;padding:12px 16px;font-size:14px;line-height:1.55;color:#1d2433;white-space:pre-line;\">{{ $('Generate Draft').first().json.headline_text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}</div>\n</td></tr>\n<tr><td align=\"left\" style=\"padding:24px 28px 8px 28px;\">\n<a href=\"{{ $('Generate Draft').first().json.view_url }}\" style=\"display:inline-block;background:#1d4ed8;color:#ffffff;text-decoration:none;font-size:15px;font-weight:600;padding:12px 22px;border-radius:6px;\">Read the full briefing</a>\n</td></tr>\n<tr><td style=\"padding:12px 28px 24px 28px;font-size:14px;line-height:1.55;color:#1d2433;\">\n<strong>To approve or disapprove:</strong> the buttons on the original Slack request have expired. In n8n, run\n<em>02 - Briefing Approval and Delivery</em> again to send a fresh approval request.\n</td></tr>\n<tr><td style=\"padding:16px 28px;border-top:1px solid #eceef3;font-size:12px;line-height:1.5;color:#8a91a1;\">\nSent by the Media Monitoring Agent because no Approve or Disapprove was received within the approval window.\nThe briefing link is signed and expires after 72 hours.\n</td></tr>\n</table>\n</div>"
      },
