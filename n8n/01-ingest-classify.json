              "value": "={{ $env.MM_API_KEY }}"
            }
          ]
        }
      },
      "name": "Get Pending Alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "id": "a531aef3-9f24-4603-a003-bc8a5fb7f5d3"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Loop Over Alerts",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "id": "95c5c701-62ec-45ea-892b-27c290c62a3e",
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "C0C5X8PMAQ2",
          "mode": "id"
        },
        "text": "={{ Number($json.risk_score) >= 0.85 ? ':red_circle:' : ':large_orange_circle:' }} {{ $json.source === 'Synthetic Demo Data' ? '[SYNTHETIC DEMO DATA] ' : '' }}:rotating_light: *Risk alert {{ Number($json.risk_score).toFixed(2) }}* — {{ $json.title }}\nSource: {{ $json.source }}\nWhy: {{ $json.reason }}\n{{ $json.url }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "name": "Post Alert to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "id": "7526c9ba-fcca-45a9-9c4f-a7330fe724fe",
      "position": [
        1340,
        380
      ],
      "credentials": {
        "slackApi": {
          "id": "75TRkaqNm6DBlkaE",
          "name": "Slack account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/alerts/{{ $('Loop Over Alerts').item.json.alert_id }}/ack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.MM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"acknowledged_by\": \"n8n: posted to Slack C0C5X8PMAQ2\"}",
        "options": {
          "timeout": 30000
        }
      },
      "name": "Acknowledge Alert (POST /alerts/{id}/ack)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "id": "02515d2f-dc68-4499-8517-50e57f27ac80",
      "position": [
        1560,
        380
      ]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Call /ingest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call /ingest": {
      "main": [
        [
          {
            "node": "Call /classify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call /classify": {
      "main": [
        [
          {
            "node": "Get Pending Alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Pending Alerts": {
      "main": [
        [
          {
            "node": "Loop Over Alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Alerts": {
      "main": [
        [],
        [
          {
            "node": "Post Alert to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post Alert to Slack": {
      "main": [
        [
          {
            "node": "Acknowledge Alert (POST /alerts/{id}/ack)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Acknowledge Alert (POST /alerts/{id}/ack)": {
      "main": [
        [
          {
            "node": "Loop Over Alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Now (manual)": {
      "main": [
        [
          {
            "node": "Call /ingest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "mmErrorWorkflw03"
  },
  "active": true,
  "_note": "Every 5 min: ingest -> classify -> fetch ALL pending alerts -> for each: post to Slack (C0C5X8PMAQ2) -> ack. Ack only after a successful post (at-least-once: a failed post leaves the alert pending for the next cycle and fires the error workflow; worst case is a duplicate post, never a lost alert). The ack is a SYSTEM acknowledgement (acknowledged_by='n8n: posted to Slack ...'), not a human one. Outbound only (chat.postMessage) - no tunnel needed. AUTH: HTTP nodes send X-API-Key from $env.MM_API_KEY. 'Run Now (manual)' runs one cycle on demand (n8n UI or CLI `n8n execute`). Severity cue: red circle for risk >= 0.85, orange for the rest (all alerts are already >= the 0.70 alert threshold). Display only: it does not change which items alert."
}
