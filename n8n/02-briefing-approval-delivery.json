{
  "id": "mmBriefingAppr02",
  "name": "02 - Briefing Approval and Delivery",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 5 * * *"
            }
          ]
        }
      },
      "name": "05:30 Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        384,
        384
      ],
      "id": "5702fed8-3b5c-4f80-9b89-2b6ca96cd01a"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/brief",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.MM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 300000
        }
      },
      "name": "Generate Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        608,
        384
      ],
      "id": "28dced8e-1934-4061-8f4d-d91014cd3f2f"
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "C0C5X8PMAQ2",
          "mode": "id"
        },
        "message": "={{ $json.slack_summary }}",
        "approvalOptions": {
          "values": {}
        },
        "captureResponder": true,
        "options": {
          "limitWaitTime": {
            "values": {
              "resumeAmount": 120,
              "resumeUnit": "minutes"
            }
          }
        }
      },
      "name": "Send For Approval (Slack Send-and-Wait)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        832,
        384
      ],
      "id": "d3cb9d44-c575-4ccb-949f-dc5265a3a095",
      "webhookId": "c57cb79d-34d3-44d3-ade7-92b4493acea3",
      "credentials": {
        "slackApi": {
          "id": "75TRkaqNm6DBlkaE",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cda761b9-2752-4a73-b4b7-06f9917ad795",
              "leftValue": "={{ $json.data?.approved === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "19c904e1-8f79-4e33-a172-62ff23161c1b",
              "leftValue": "={{ $json.data?.responder?.id ?? '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Approved by a Named Analyst?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "id": "f3329136-f93c-4a96-9e45-2ceedde34759",
      "position": [
        1056,
        384
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/brief/{{ $('Generate Draft').first().json.briefing_id }}/approve",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.MM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ approved_by: 'slack:' + ($json.data.responder.email || $json.data.responder.name || $json.data.responder.username || $json.data.responder.id) + ' (' + $json.data.responder.id + ')' }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "name": "Record Approval (POST /approve)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "id": "28eb5650-8d81-405b-a6dd-75d611e9cd05",
      "position": [
        1280,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/brief/{{$json.briefing_id}}/deliver",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.MM_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Mark Delivered (POST /deliver)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1504,
        304
      ],
      "id": "5c5d9fca-01f9-4403-a119-a2ce599dfdb8"
    },
    {
      "parameters": {
        "otherOptions": {}
      },
      "name": "Escalate To Backup Analyst",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1280,
        496
      ],
      "id": "ca0e920e-23f8-4b65-b6fb-bf0d8f2f5a6b",
      "webhookId": "d6e72fac-06ba-4434-9aae-75b427a639a0",
      "credentials": {
        "slackApi": {
          "id": "75TRkaqNm6DBlkaE",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "C0C5ZN72R0S",
          "mode": "id"
        },
        "text": "={{ $json.delivery_summary }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "name": "Post Approved Briefing to DG Office (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "id": "a350a8dc-8fcd-4264-a4e7-f8a5a55c8093",
      "position": [
        1728,
        304
      ],
      "credentials": {
        "slackApi": {
          "id": "75TRkaqNm6DBlkaE",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "05:30 Daily": {
      "main": [
        [
          {
            "node": "Generate Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Draft": {
      "main": [
        [
          {
